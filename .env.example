# Evaluation model
EVALUATION_MODEL_NAME=Model Name
EVALUATION_LLM_MODEL=provider/model-name
EVALUATION_LLM_BASE_URL=
# Optional for endpoints that do not require authentication.
EVALUATION_LLM_API_KEY=
# Optional: Some models need this
EVALUATION_LLM_REASONING_EFFORT=

# Use "litellm" for chat models or "clef" for the SystemOne endpoint.
EVALUATION_PROVIDER=litellm

# Experiment identity
# Keep one ID for every task and repeated run in the same experimental batch.
EXPERIMENT_ID=thesis-main-evaluation-01

# Inputs and outputs
TASKS_DIR=dataset-02
RESULTS_DIR=results
EVALUATION_PROMPT_PATH=installguideeval/prompts/01_minimal.md
EVALUATION_CRITERIA_PATH=criteria/evaluation_criteria.json

# API settings
API_TIMEOUT_SECONDS=300
