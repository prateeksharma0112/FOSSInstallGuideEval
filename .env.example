# Evaluation model
EVALUATION_LLM_MODEL=provider/model-name
EVALUATION_LLM_API_KEY=replace-with-api-key
# Base URL of the organisation's OpenAI-compatible or LiteLLM endpoint.
EVALUATION_LLM_BASE_URL=
EVALUATION_LLM_REASONING_EFFORT=
EVALUATION_MAX_OUTPUT_TOKENS=12000

# Experiment identity
# Keep one ID for every task and repeated run in the same experimental batch.
EXPERIMENT_ID=thesis-main-evaluation-01

# Inputs and outputs
TASKS_DIR=dataset-02
RESULTS_DIR=results
EVALUATION_PROMPT_PATH=installguideeval/prompts/evaluation_prompt.md
EVALUATION_CRITERIA_PATH=criteria/evaluation_criteria.json

API_TIMEOUT_SECONDS=300
